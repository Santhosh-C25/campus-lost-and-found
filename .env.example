# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus-lost-found?retryWrites=true&w=majority

# Session Secret (use a long random string)
SESSION_SECRET=your_super_secret_session_key_change_this_in_production

# Admin Seed Credentials (used by scripts/seed.js)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@123456

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Upload size limit in MB
MAX_FILE_SIZE_MB=5
